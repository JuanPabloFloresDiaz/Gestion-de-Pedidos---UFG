# Copia este archivo a .env y ajusta. Solo valores de DESARROLLO: nunca reutilices estos en producción.
# Contraseñas: mínimo 8 caracteres con mayúsculas, minúsculas, dígitos y símbolos (exigencia de SQL Server).

# Puertos del host (secuencia del ecosistema del equipo)
API_PORT=4390
SQL_PORT=4391
WEB_PORT=4392

# SQL Server
MSSQL_SA_PASSWORD=Sa_Dev_Password_123!
MSSQL_PID=Developer
MSSQL_MEMORY_LIMIT_MB=1536
PEDIDOS_APP_PASSWORD=App_Dev_Password_123!
PEDIDOS_MIGRATOR_PASSWORD=Migrator_Dev_Password_123!

# API
JWT_SIGNING_KEY=clave-solo-para-desarrollo-local-no-usar-en-produccion-0123456789
ADMIN_INITIAL_PASSWORD=Admin_Dev_Password_123!

# Datos de ejemplo realistas (catálogo, clientes, pedidos, historial). true en desarrollo; false para una base limpia.
SEMBRAR_DATOS_EJEMPLO=true
