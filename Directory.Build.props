<Project>
  <!-- Propiedades comunes de TODOS los proyectos. La versión de .NET vive solo aquí y en global.json
       (así migrar de versión es cambiar estos archivos; ver docs/Migracion-NET10.md). -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <!-- Comentarios XML obligatorios (requisito de la materia): un público sin comentar es error CS1591 -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <Deterministic>true</Deterministic>
    <InvariantGlobalization>false</InvariantGlobalization>
  </PropertyGroup>
</Project>
