<Project Sdk="Microsoft.NET.Sdk.Razor">
  <!--
    Hospedaje NATIVO: .NET MAUI Blazor Hybrid. Es una capa delgada: un BlazorWebView que carga la interfaz compartida
    (GestionPedidos.Ui). Tiene dos destinos:
      * ESCRITORIO (Windows):  dotnet build -f net10.0-windows10.0.19041.0   |   dotnet run -f net10.0-windows10.0.19041.0
      * CELULAR (Android):     dotnet build -f net10.0-android -t:Run        (ver docs/Equipo/PruebaMovil.md)
    Windows solo se ofrece cuando se compila en Windows. Requisitos: SDK de .NET 8 y la carga de trabajo de MAUI
    (dotnet workload install maui, o maui-android si solo se quiere el celular). No corre en Docker.
  -->
  <PropertyGroup>
    <!-- Sustituyen al TargetFramework común de Directory.Build.props: se vacía el singular para que valga la lista -->
    <TargetFramework></TargetFramework>
    <TargetFrameworks>net10.0-android</TargetFrameworks>
    <TargetFrameworks Condition="$([MSBuild]::IsOSPlatform('windows'))">$(TargetFrameworks);net10.0-windows10.0.19041.0</TargetFrameworks>
    <OutputType>Exe</OutputType>
    <RootNamespace>GestionPedidos.Desktop</RootNamespace>
    <UseMaui>true</UseMaui>
    <SingleProject>true</SingleProject>
    <EnableDefaultCssItems>false</EnableDefaultCssItems>

    <!-- Código generado por MAUI/XAML: sin la exigencia de comentarios XML ni advertencias como errores -->
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <!-- Esta capa usa sus propias versiones (las de MAUI), no las centralizadas del resto de la solución -->
    <ManagePackageVersionsCentrally>false</ManagePackageVersionsCentrally>

    <ApplicationTitle>NoviXtore</ApplicationTitle>
    <ApplicationId>sv.edu.ufg.gestionpedidos</ApplicationId>
    <ApplicationDisplayVersion>1.0</ApplicationDisplayVersion>
    <ApplicationVersion>1</ApplicationVersion>
  </PropertyGroup>

  <!-- Solo Windows -->
  <PropertyGroup Condition="$(TargetFramework.Contains('-windows'))">
    <OutputType>WinExe</OutputType>
    <SupportedOSPlatformVersion>10.0.17763.0</SupportedOSPlatformVersion>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <!-- Ejecutable sin empaquetar (sin MSIX ni firma) y con el runtime de Windows App SDK incluido: así corre en
         equipos del laboratorio sin instalar nada adicional (solo se necesita WebView2, que trae Windows 10/11). -->
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
  </PropertyGroup>

  <!-- Solo Android: Android 5.0 (API 21) o superior -->
  <PropertyGroup Condition="$(TargetFramework.Contains('-android'))">
    <SupportedOSPlatformVersion>21.0</SupportedOSPlatformVersion>
    <!-- APK para instalar en un celular o emulador (no el paquete .aab de la tienda) -->
    <AndroidPackageFormat>apk</AndroidPackageFormat>
  </PropertyGroup>

  <ItemGroup>
    <MauiIcon Include="Resources\AppIcon\appicon.svg" ForegroundFile="Resources\AppIcon\appiconfg.svg" Color="#2F5BEA" />
    <MauiSplashScreen Include="Resources\Splash\splash.svg" Color="#2F5BEA" BaseSize="128,128" />
    <MauiImage Include="Resources\Images\*" />
    <MauiFont Include="Resources\Fonts\*" />
  </ItemGroup>

  <!-- Dirección de la API: en Windows, appsettings.json junto al .exe; en Android, appsettings.android.json viaja DENTRO
       del APK (activo de MAUI llamado appsettings.json). -->
  <ItemGroup Condition="$(TargetFramework.Contains('-windows'))">
    <None Include="appsettings.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <ItemGroup Condition="$(TargetFramework.Contains('-android'))">
    <MauiAsset Include="appsettings.android.json" LogicalName="appsettings.json" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Maui.Controls" Version="$(MauiVersion)" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebView.Maui" Version="$(MauiVersion)" />
    <PackageReference Include="Microsoft.Extensions.Logging.Debug" Version="8.0.1" />
    <ProjectReference Include="..\GestionPedidos.Ui\GestionPedidos.Ui.csproj" />
  </ItemGroup>
</Project>
