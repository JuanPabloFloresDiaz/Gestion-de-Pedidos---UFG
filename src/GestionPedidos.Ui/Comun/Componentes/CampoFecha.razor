@* Campo de fecha del kit (solo día), con etiqueta y error integrados. *@
@{ var id = _id; }
<div class="campo @(string.IsNullOrEmpty(Error) ? "" : "campo-error")">
    <label for="@id">@Etiqueta</label>
    <input id="@id" type="date" value="@(Valor?.ToString("yyyy-MM-dd"))" disabled="@Deshabilitado" @onchange="AlCambiar" />
    @if (!string.IsNullOrEmpty(Error)) { <small class="mensaje-error" role="alert">@Error</small> }
</div>

@code {
    private readonly string _id = "f" + Guid.NewGuid().ToString("N")[..8];

    /// <summary>Texto de la etiqueta.</summary>
    [Parameter] public string Etiqueta { get; set; } = "";
    /// <summary>Fecha elegida, o <c>null</c> (admite <c>@bind-Valor</c>).</summary>
    [Parameter] public DateOnly? Valor { get; set; }
    /// <summary>Se produce al cambiar la fecha.</summary>
    [Parameter] public EventCallback<DateOnly?> ValorChanged { get; set; }
    /// <summary>Mensaje de error visible bajo el campo.</summary>
    [Parameter] public string? Error { get; set; }
    /// <summary>Bloquea el campo.</summary>
    [Parameter] public bool Deshabilitado { get; set; }

    private Task AlCambiar(ChangeEventArgs e) =>
        ValorChanged.InvokeAsync(DateOnly.TryParse(e.Value?.ToString(), out var f) ? f : null);
}
