@* Portada. En el escritorio lleva directo al login; en la web es la portada de la tienda: promoción, categorías y novedades. *@
@page "/"
@layout TiendaLayout
@implements IDisposable
@inject CatalogoViewModel Vm
@inject NavigationManager Nav
@inject UiOptions Opciones

<PageTitle>Tienda GP</PageTitle>

@if (!Opciones.EsEscritorio)
{
    <section class="portada">
        <div class="portada-texto">
            <span class="portada-etiqueta">Nueva temporada</span>
            <h1>Encuentra lo que buscas, <em>sin salir de casa</em></h1>
            <p>Ropa, tecnología, hogar, deportes y más. Haz tu pedido en línea y sigue su estado desde tu cuenta.</p>
            <div class="portada-botones">
                <a class="boton boton-primario" href="/tienda">Ver el catálogo</a>
                <a class="boton boton-secundario" href="/registro">Crear mi cuenta</a>
            </div>
            <ul class="portada-ventajas">
                <li><Icono Svg="Lucide.PackageCheck" /> Pedidos con seguimiento</li><li><Icono Svg="Lucide.Tags" /> Productos descritos al detalle</li><li><Icono Svg="Lucide.Truck" /> Entregas en todo El Salvador</li>
            </ul>
        </div>
        <div class="portada-collage" aria-hidden="true">
            @foreach (var (c, i) in Vm.Categorias.Take(4).Select((c, i) => (c, i)))
            {
                <div class="collage-pieza pieza-@i" style="--h:@TiendaVisual.Tono(c.Id)">
                    <Icono Svg="TiendaVisual.Icono(null, c.Nombre)" />
                    @if (c.ImagenUrl is not null) { <img src="@c.ImagenUrl" alt="" loading="lazy" onerror="this.remove()" /> }
                </div>
            }
        </div>
    </section>

    <section class="seccion">
        <div class="seccion-cabecera"><h2>Compra por categoría</h2><a class="enlace-flecha" href="/tienda">Ver todo <Icono Svg="Lucide.ArrowRight" /></a></div>
        <div class="categorias-tarjetas">
            @foreach (var c in Vm.Categorias)
            {
                <a class="categoria-tarjeta" href="/tienda?categoria=@c.Id" style="--h:@TiendaVisual.Tono(c.Id)">
                    <span class="categoria-imagen" aria-hidden="true">
                        <Icono Svg="TiendaVisual.Icono(null, c.Nombre)" />
                        @if (c.ImagenUrl is not null) { <img src="@c.ImagenUrl" alt="" loading="lazy" onerror="this.remove()" /> }
                    </span>
                    <strong>@c.Nombre</strong>
                    <small>@c.TotalProductos productos · @c.Subcategorias.Count subcategorías</small>
                </a>
            }
        </div>
    </section>

    <section class="seccion">
        <div class="seccion-cabecera"><h2>Recién llegados</h2><a class="enlace-flecha" href="/tienda?orden=nuevos">Ver más <Icono Svg="Lucide.ArrowRight" /></a></div>
        @if (!string.IsNullOrEmpty(Vm.Error)) { <div class="alerta alerta-error" role="alert">@Vm.Error</div> }
        <div class="cuadricula cuadricula-4">
            @if (!Vm.Cargado)
            {
                @for (var i = 0; i < 4; i++) { <div class="tarjeta-producto esqueleto" aria-hidden="true"></div> }
            }
            else
            {
                @foreach (var p in Vm.Pagina?.Elementos.Take(8) ?? Enumerable.Empty<ProductoTiendaDto>()) { <TarjetaProducto P="p" @key="p.Id" /> }
            }
        </div>
    </section>
}

@code {
    protected override async Task OnInitializedAsync()
    {
        if (Opciones.EsEscritorio) { Nav.NavigateTo("/ingresar", replace: true); return; }   // el escritorio es solo para el personal
        Vm.Cambiado += Vm_Cambiado;     // suscripción con +=
        await Vm.CargarAsync(new FiltrosCatalogo(SoloDisponibles: true));
    }

    private void Vm_Cambiado(object? sender, EventArgs e) => _ = InvokeAsync(StateHasChanged);

    /// <summary>Baja de la suscripción.</summary>
    public void Dispose() => Vm.Cambiado -= Vm_Cambiado;
}
