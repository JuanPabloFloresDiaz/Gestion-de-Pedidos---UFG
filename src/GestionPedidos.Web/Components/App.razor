@* Documento HTML raíz del hospedaje web. La interfaz (rutas, páginas, estilos) viene de GestionPedidos.Ui. *@
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="color-scheme" content="light dark" />
    <base href="/" />
    <title>Gestión de Pedidos</title>
    <script src="_content/GestionPedidos.Ui/js/apariencia.js"></script>
    <link rel="stylesheet" href="_content/GestionPedidos.Ui/css/tema.css" />
    <link rel="stylesheet" href="_content/GestionPedidos.Ui/css/tienda.css" />
    <script src="_content/GestionPedidos.Ui/js/tienda.js"></script>
    <HeadOutlet @rendermode="Modo" />
</head>
<body>
    <Routes @rendermode="Modo" />
    <div id="blazor-error-ui" style="display:none;position:fixed;bottom:0;left:0;right:0;padding:10px;background:#c53030;color:#fff;z-index:100">
        Ocurrió un error inesperado. <a href="" style="color:#fff">Recargar</a>
    </div>
    <script src="_framework/blazor.web.js"></script>
</body>
</html>

@code {
    // Sin pre-renderizado: la sesión vive en ProtectedSessionStorage (JavaScript) y solo se lee tras el primer render.
    private static readonly IComponentRenderMode Modo = new InteractiveServerRenderMode(prerender: false);
}
